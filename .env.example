# Application Settings
APP_NAME=Meatapivot
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# Database - PostgreSQL
DATABASE_URL=postgresql+asyncpg://knowledge:kpassword@localhost:5432/knowledge_db
POSTGRES_USER=knowledge
POSTGRES_PASSWORD=kpassword
POSTGRES_DB=knowledge_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database - Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4jpassword
NEO4J_DATABASE=neo4j

# Message Queue - RabbitMQ
RABBITMQ_URL=amqp://user:rabbitmq@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=user
RABBITMQ_PASSWORD=rabbitmq

# Object Storage - MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=documents
MINIO_SECURE=false

# Cache - Redis
REDIS_URL=redis://localhost:6379/0

# Identity Provider - Keycloak
KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=knowledge-platform
KEYCLOAK_CLIENT_ID=knowledge-client
KEYCLOAK_CLIENT_SECRET=client-secret-here

# Security
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# File Upload
MAX_UPLOAD_SIZE=104857600
ALLOWED_EXTENSIONS=pdf,docx,txt,md,csv,xlsx,xls,pptx,jpg,png

# Search & NLP
SENTENCE_TRANSFORMERS_MODEL=all-MiniLM-L6-v2
BM25_INDEX_PATH=./data/bm25_index

# LLM Gateway - One API
ONE_API_URL=http://localhost:3005/v1
ONE_API_KEY=sk-your-api-key-here
DEFAULT_LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7
LLM_RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json