      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket{job=\"knowledge-platform-backend\"}[5m])) * 1000",
          "refId": "A"
        }
      ],
      "title": "P95 Latency (ms)",
